<mvc:View
    controllerName="code.cl3.day8extraclass.controller.View001"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:t="sap.ui.table"
    xmlns:u="sap.ui.unified"
    xmlns:c="sap.ui.core"
>
    <Page
        id="page"
        title="{i18n>title}"
    >
        <content>
            <VBox>
                <OverflowToolbar >
                    <ToolbarSpacer />
                    <SearchField
                        ariaLabelledBy="text1"
                        id="maxPrice"
                        liveChange="onFilter"
                    >
                        <layoutData>
                            <OverflowToolbarLayoutData
                                maxWidth="300px"
                                shrinkable="true"
                                priority="NeverOverflow"
                            />
                        </layoutData>
                    </SearchField>
                    <Button
                        text="Reset"
                        type="Transparent"
                        press="onReset"
                    />
                    <OverflowToolbarButton
                        tooltip="Sort"
                        type="Transparent"
                        text="Sort"
                        icon="sap-icon://sort"
                        press="onSort"
                    />
                    <OverflowToolbarButton
                        tooltip="Group"
                        type="Transparent"
                        text="Group"
                        icon="sap-icon://group-2"
                        press="onGroup"
                    />
                    <OverflowToolbarMenuButton
                        tooltip="Export"
                        type="Transparent"
                        text="Export"
                        buttonMode="Split"
                        icon="sap-icon://share"
                        defaultAction="onDefaultActionAccept"
                        beforeMenuOpen="onBeforeMenuOpen"
                        useDefaultActionOnly="true"
                    >
                        <menu>
                            <Menu itemSelected="onMenuAction">
                                <MenuItem
                                    text="Export as PDF"
                                    icon="sap-icon://pdf-attachment"
                                />
                                <MenuItem
                                    text="Export to Excel"
                                    icon="sap-icon://excel-attachment"
                                />
                            </Menu>
                        </menu>
                    </OverflowToolbarMenuButton>
                </OverflowToolbar>

                <t:Table
                    rows="{/scarr}"
                    selectionMode="None"
                >
                    <t:columns>
                        <t:Column width="11rem">
                            <Label text="CARR ID" />
                            <t:template>
                                <Text
                                    text="{CARRID}"
                                    wrapping="false"
                                />
                            </t:template>
                        </t:Column>
                        <t:Column width="11rem">
                            <Label text="CARRNAME" />
                            <t:template>
                                <Text
                                    text="{CARRNAME}"
                                    wrapping="false"
                                />
                            </t:template>
                        </t:Column>
                        <t:Column width="11rem">
                            <Label text="CURRCODE" />
                            <t:template>
                                <Text
                                    text="{CURRCODE}"
                                    wrapping="false"
                                />
                            </t:template>
                        </t:Column>
                        <t:Column width="13rem">
                            <Label text="URL" />
                            <t:template>
                                <Link
                                    text="{URL}"
                                    href="{URL}"
                                />
                            </t:template>
                        </t:Column>
                    </t:columns>
                </t:Table>
            </VBox>
        </content>
    </Page>
</mvc:View>
