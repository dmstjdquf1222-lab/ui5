<mvc:View
    controllerName="coe.cl3.day10ui502.controller.SecondView"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
>
    <Page
        id="page2"
        title="{i18n>title}"
    >
        <Panel
            class="sapUiResponsiveMargin"
            expandable="true"
            expanded="true"
            headerText="Second view"
            width="12rem"
        >
            <Button
                text="Go First"
                icon="sap-icon://cargo-train"
                press="goFirst()"
            />
            <Button
                text="Go Third"
                icon="sap-icon://cargo-train"
                press="goThird()"
            />
        </Panel>
    </Page>
</mvc:View>
