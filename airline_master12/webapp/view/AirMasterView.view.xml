<mvc:View
    controllerName="cl3.airlinemaster.airlinemaster12.controller.AirMasterView"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:t="sap.ui.table"
    xmlns:u="sap.ui.unified"
    xmlns:c="sap.ui.core"
    xmlns:f="sap.ui.layout.form"
>
    <Page
        id="page"
        title="{i18n>title}"
    >
        <VBox>
            <Panel
                class="sapUiResponsiveMargin"
                width="660px"
            >
                <MessageStrip
                    showIcon="true"
                    text="Data control"
                    showCloseButton="false"
                />
                <OverflowToolbar>
                    <ToolbarSpacer />
                    <Button
                        text="Display"
                        type="Accept"
                        icon="sap-icon://detail-view"
                        press="onDisplay"
                    />
                    <Button
                        text="Create"
                        type="Attention"
                        icon="sap-icon://create"
                        press="onCreate"
                    />
                    <Button
                        text="Update"
                        type="Attention"
                        icon="sap-icon://write-new-document"
                        press="onUpdate"
                    />
                    <Button
                        text="Delete"
                        type="Accept"
                        icon="sap-icon://delete"
                        press="onDelete"
                    />
                </OverflowToolbar>
                <f:SimpleForm
                    layout="ResponsiveGridLayout"
                    title="Content"
                >
                    <f:content>
                        <Label text="Airline code" />
                        <Input
                            id="Carrid"
                            width="3rem"
                        />
                        <Label text="Airline" />
                        <Input
                            id="Carrname"
                            width="10rem"
                        />
                        <Label text="Currency" />
                        <Input
                            id="Currcode"
                            width="3rem"
                        />
                        <Label text="Airline URL" />
                        <Input
                            id="Url"
                            width="13rem"
                        />
                    </f:content>
                </f:SimpleForm>
            </Panel>

            <Panel
                class="sapUiResponsiveMargin"
                headerText="Airline Master"
                width="55rem"
            >
                <t:Table
                    rows="{Schedule>/AirlineSet}"
                    selectionMode="Single"
                    id="air"
                >
                    <t:extension>
                        <OverflowToolbar style="Clear">
                            <Title text="Airline master" />
                        </OverflowToolbar>
                    </t:extension>

                    <t:columns>
                        <t:Column width="10rem">
                            <Label text="Airline" />
                            <t:template>
                                <Text
                                    text="{Schedule>Carrid}"
                                    wrapping="false"
                                />
                            </t:template>
                        </t:Column>
                        <t:Column width="13rem">
                            <Label text="Carrname" />
                            <t:template>
                                <Text
                                    text="{Schedule>Carrname}"
                                    wrapping="false"
                                />
                            </t:template>
                        </t:Column>
                        <t:Column width="13rem">
                            <Label text="Currcode" />
                            <t:template>
                                <Text
                                    text="{Schedule>Currcode}"
                                    wrapping="false"
                                />
                            </t:template>
                        </t:Column>
                        <t:Column width="13rem">
                            <Label text="Url" />
                            <t:template>
                                <Text
                                    text="{Schedule>Url}"
                                    wrapping="false"
                                />
                            </t:template>
                        </t:Column>
                    </t:columns>
                </t:Table>
            </Panel>

            
        </VBox>
    </Page>
</mvc:View>
