<mvc:View
    controllerName="cl3.student.project2.controller.StudentView"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:t="sap.ui.table"
    xmlns:u="sap.ui.unified"
    xmlns:c="sap.ui.core"
    xmlns:f="sap.ui.layout.form"
>
    <Page
        id="page"
        title="{i18n>title}"
    >
        <VBox>
            <Panel
                class="sapUiResponsiveMargin"
                width="660px"
            >
                <MessageStrip
                    showIcon="true"
                    text="Data control"
                    showCloseButton="false"
                />
                <OverflowToolbar>
                    <ToolbarSpacer />
                    <Button
                        text="Display"
                        type="Accept"
                        icon="sap-icon://detail-view"
                        press="onDisplay"
                    />
                    <Button
                        text="Create"
                        type="Attention"
                        icon="sap-icon://create"
                        press="onCreate"
                    />
                    <Button
                        text="Update"
                        type="Attention"
                        icon="sap-icon://write-new-document"
                        press="onUpdate"
                    />
                    <Button
                        text="Delete"
                        type="Accept"
                        icon="sap-icon://delete"
                        press="onDelete"
                    />
                </OverflowToolbar>
                <f:SimpleForm
                    layout="ResponsiveGridLayout"
                    title="Data CRUD"
                >
                    <f:content>
                        <Label text="{/#StudentSet/StdtNo/@sap:label}" />
                        <Input
                            id="StdtNo"
                            width="10rem"
                        />
                        <Label text="{/#StudentSet/Major/@sap:label}" />
                        <Input
                            id="Major"
                            width="3rem"
                        />
                        <Label text="{/#StudentSet/StdtName/@sap:label}" />
                        <Input
                            id="StdtName"
                            width="10rem"
                        />
                        <Label text="{/#StudentSet/Addr/@sap:label}" />
                        <Input
                            id="Addr"
                            width="20rem"
                        />
                        <Label text="{/#StudentSet/Email/@sap:label}" />
                        <Input
                            id="Email"
                            width="20rem"
                        />
                        <Label text="{/#StudentSet/Gender/@sap:label}" />
                        <Input
                            id="Gender"
                            width="3rem"
                        />
                    </f:content>
                </f:SimpleForm>
            </Panel>

            <Panel
                class="sapUiResponsiveMargin"
                headerText="Student master"
                width="55rem"
            >
                <t:Table
                    rows="{/StudentSet}"
                    selectionMode="Single"
                    id="Student"
                >
                    <t:extension>
                        <OverflowToolbar style="Clear">
                            <Title text="Student master" />
                        </OverflowToolbar>
                    </t:extension>

                    <t:columns>
                        <t:Column width="8rem">
                            <Label text="Student No" />
                            <t:template>
                                <Text
                                    text="{StdtNo}"
                                    wrapping="false"
                                />
                            </t:template>
                        </t:Column>
                        <t:Column width="5rem">
                            <Label text="Major" />
                            <t:template>
                                <Text
                                    text="{Major}"
                                    wrapping="false"
                                />
                            </t:template>
                        </t:Column>
                        <t:Column width="8rem">
                            <Label text="Student Name" />
                            <t:template>
                                <Text
                                    text="{StdtName}"
                                    wrapping="false"
                                />
                            </t:template>
                        </t:Column>
                        <t:Column width="12rem">
                            <Label text="Address" />
                            <t:template>
                                <Text
                                    text="{Addr}"
                                    wrapping="false"
                                />
                            </t:template>
                        </t:Column>
                        <t:Column width="12rem">
                            <Label text="Email" />
                            <t:template>
                                <Text
                                    text="{Email}"
                                    wrapping="false"
                                />
                            </t:template>
                        </t:Column>
                        <t:Column width="5rem">
                            <Label text="Gender" />
                            <t:template>
                                <Text
                                    text="{Gender}"
                                    wrapping="false"
                                />
                            </t:template>
                        </t:Column>
                    </t:columns>
                </t:Table>
            </Panel>
        </VBox>
    </Page>
</mvc:View>
