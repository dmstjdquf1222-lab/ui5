<mvc:View
    controllerName="gatewaypractice.gatewaypractice.controller.GatewayPracticeView1"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:t="sap.ui.table"
    xmlns:u="sap.ui.unified"
    xmlns:c="sap.ui.core"
>
    <Page
        id="page"
        title="{i18n>title}"
    >
        <VBox>
            <Panel
                class="sapUiResponsiveMargin"
                headerText="Gateway practice"
                width="auto"
            >
                <t:Table
                    id="Table"
                    rows="{/AccountSet}"
                    selectionMode="None"
                >
                    <t:extension>
                        <OverflowToolbar style="Clear">
                            <Title text="Gateway practice" />
                            <ToolbarSpacer />
                            <Button
                                icon="sap-icon://search"
                                press="onSearch()"
                                text="Search"
                                type="Neutral"
                            />
                            <Input
                                id="BUKRS"
                                width="10rem"
                                showClearIcon="true"
                                placeholder="Company Code"
                            />
                            
                            <Input
                                id="BELNR"
                                width="10rem"
                                showClearIcon="true"
                                placeholder="Document Number"
                            />
                            <Input
                                id="GJAHR"
                                width="10rem"
                                showClearIcon="true"
                                placeholder="Fiscal Year"
                            />
                        </OverflowToolbar>
                    </t:extension>

                    <t:columns>
                        <t:Column width="8rem">
                            <Label text="Company Code" />
                            <t:template>
                                <Text
                                    text="{Bukrs}"
                                    wrapping="false"
                                />
                            </t:template>
                        </t:Column>
                        <t:Column width="9rem">
                            <Label text="Document Number" />
                            <t:template>
                                <Text
                                    text="{Belnr}"
                                    wrapping="false"
                                />
                            </t:template>
                        </t:Column>
                        <t:Column width="8rem">
                            <Label text="Fiscal Year" />
                            <t:template>
                                <Text
                                    text="{Gjahr}"
                                    wrapping="false"
                                />
                            </t:template>
                        </t:Column>
                        <t:Column width="8rem">
                            <Label text="Item" />
                            <t:template>
                                <Text
                                    text="{Buzei}"
                                    wrapping="false"
                                />
                            </t:template>
                        </t:Column>
                        <t:Column width="8rem">
                            <Label text="Debit/Credit" />
                            <t:template>
                                <Text
                                    text="{Shkzg}"
                                    wrapping="false"
                                />
                            </t:template>
                        </t:Column>
                        <t:Column width="8rem">
                            <Label text="Business Area" />
                            <t:template>
                                <Text
                                    text="{Gsber}"
                                    wrapping="false"
                                />
                            </t:template>
                        </t:Column>
                        <t:Column width="8rem">
                            <Label text="Amount" />
                            <t:template>
                                <Text
                                    text="{parts:[{path:'Wrbtr'},{path:'Waers'}],
	                                type: 'sap.ui.model.type.Currency',
	                                formatOptions: {showMeasure: true }}"
                                    wrapping="false"
                                />
                            </t:template>
                        </t:Column>
                        <t:Column width="8rem">
                            <Label text="Quantity" />
                            <t:template>
                                <Text
                                    text="{parts:[{path:'Menge'},{path:'Meins'}],
	                                type: 'sap.ui.model.type.Unit',
	                                formatOptions: {showMeasure: true }}"
                                    wrapping="false"
                                />
                            </t:template>
                        </t:Column>
                        <t:Column width="8rem">
                            <Label text="Tax Code" />
                            <t:template>
                                <Text
                                    text="{Mwskz}"
                                    wrapping="false"
                                />
                            </t:template>
                        </t:Column>
                    </t:columns>
                </t:Table>
            </Panel>
        </VBox>
    </Page>
</mvc:View>
