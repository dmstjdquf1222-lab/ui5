<mvc:View
    controllerName="cl3.concat.codecl3ui501.controller.ConcatPractice"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:t="sap.ui.table"
    xmlns:u="sap.ui.unified"
    xmlns:c="sap.ui.core"
>
    <Page
        id="page"
        title="{i18n>title}"
    >
        <VBox>
            <Panel
                class="sapUiResponsiveMargin"
                headerText="Concat practice"
                width="55rem"
            >
                <t:Table
                    rows="{/ConcatSet}"
                    selectionMode="None"
                >
                    <t:extension>
                        <OverflowToolbar style="Clear">
                            <Title text="Concat practice" />
                        </OverflowToolbar>
                    </t:extension>

                    <t:columns>
                        <t:Column width="10rem">
                            <Label text="Material code" />
                            <t:template>
                                <Text
                                    text="{carrid}"
                                    wrapping="false"
                                />
                            </t:template>
                        </t:Column>
                        <t:Column width="10rem">
                            <Label text="Material code" />
                            <t:template>
                                <Text
                                    text="{connid}"
                                    wrapping="false"
                                />
                            </t:template>
                        </t:Column>
                        <t:Column width="10rem">
                            <Label text="Material code" />
                            <t:template>
                                <Text
                                    text="{Fldate}"
                                    wrapping="false"
                                />
                            </t:template>
                        </t:Column>
                        <t:Column width="10rem">
                            <Label text="Material code" />
                            <t:template>
                                <Text
                                    text="{bookid}"
                                    wrapping="false"
                                />
                            </t:template>
                        </t:Column>
                        <t:Column width="10rem">
                            <Label text="Material code" />
                            <t:template>
                                <Text
                                    text="{Deptime}"
                                    wrapping="false"
                                />
                            </t:template>
                        </t:Column>
                        <t:Column width="10rem">
                            <Label text="Material code" />
                            <t:template>
                                <Text
                                    text="{customid}"
                                    wrapping="false"
                                />
                            </t:template>
                        </t:Column>
                        <t:Column width="10rem">
                            <Label text="Material code" />
                            <t:template>
                                <Text
                                    text="{luggweight}"
                                    wrapping="false"
                                />
                            </t:template>
                        </t:Column>
                        <t:Column width="10rem">
                            <Label text="Material code" />
                            <t:template>
                                <Text
                                    text="{wunit}"
                                    wrapping="false"
                                />
                            </t:template>
                        </t:Column>
                        <!-- <t:Column width="10rem">
                            <Label text="Material code" />
                            <t:template>
                                <Text
                                    text="{forcuram}"
                                    wrapping="false"
                                />
                            </t:template>
                        </t:Column> -->

                        <t:Column width="7rem">
                            <Label text="Foreign Amount" />
                            <t:template>
                                <Text
                                    text="{ parts:[{path:'ConcatSet>forcuram'},{path:'ConcatSet>forcurkey'}],
                                    type: 'sap.ui.model.type.Currency',formatOptions: {showMeasure: true }}"
                                    wrapping="false"
                                />
                            </t:template>
                        </t:Column>

                        <t:Column width="10rem">
                            <Label text="Material code" />
                            <t:template>
                                <Text
                                    text="{forcurkey}"
                                    wrapping="false"
                                />
                            </t:template>
                        </t:Column>
                    </t:columns>
                </t:Table>
            </Panel>
        </VBox>
    </Page>
</mvc:View>
