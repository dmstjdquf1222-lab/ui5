<mvc:View
    controllerName="cl3.concat.codecl3ui501.controller.ConcatPractice"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:t="sap.ui.table"
    xmlns:u="sap.ui.unified"
    xmlns:c="sap.ui.core"
>
    <Page
        id="page"
        title="{i18n>title}"
    >
        <VBox>
            <Panel
                class="sapUiResponsiveMargin"
                headerText="Concat practice"
                width="68rem"
            >
                <t:Table
                    rows="{/ConcatSet}"
                    selectionMode="None"
                >
                    <t:extension>
                        <OverflowToolbar style="Clear">
                            <Title text="Concat practice" />
                        </OverflowToolbar>
                    </t:extension>

                    <t:columns>
                        <t:Column width="8rem">
                            <Label text="Airline" />
                            <t:template>
                                <Text
                                    text="{carrid}"
                                    wrapping="false"
                                />
                            </t:template>
                        </t:Column>
                        <t:Column width="8rem">
                            <Label text="Connection" />
                            <t:template>
                                <Text
                                    text="{connid}"
                                    wrapping="false"
                                />
                            </t:template>
                        </t:Column>
                        <t:Column width="8rem">
                            <Label text="Flight date" />
                            <t:template>
                                <Text
                                    text="{Fldate}"
                                    wrapping="false"
                                />
                            </t:template>
                        </t:Column>
                        <t:Column width="8rem">
                            <Label text="Book ID" />
                            <t:template>
                                <Text
                                    text="{bookid}"
                                    wrapping="false"
                                />
                            </t:template>
                        </t:Column>
                        <t:Column width="8rem">
                            <Label text="Custom ID" />
                            <t:template>
                                <Text
                                    text="{customid}"
                                    wrapping="false"
                                />
                            </t:template>
                        </t:Column>
                        <t:Column width="8rem">
                            <Label text="Depature time" />
                            <t:template>
                                <Text
                                    text="{Deptime}"
                                    wrapping="false"
                                />
                            </t:template>
                        </t:Column>
                        <t:Column width="8rem">
                            <Label text="Distance" />
                            <t:template>
                                <Text
                                    text="{parts:[{path:'luggweight'},{path:'wunit'}],
	                                type: 'sap.ui.model.type.Unit',
	                                formatOptions: {showMeasure: false }}"
                                    wrapping="false"
                                />
                            </t:template>
                        </t:Column>
                        <t:Column width="8rem">
                            <Label text="Foreign Amount" />
                            <t:template>
                                <Text
                                    text="{ parts:[{path:'forcuram'},{path:'forcurkey'}],
                                    type: 'sap.ui.model.type.Currency',formatOptions: {showMeasure: false }}"
                                    wrapping="false"
                                />
                            </t:template>
                        </t:Column>
                    </t:columns>
                </t:Table>
            </Panel>
        </VBox>
    </Page>
</mvc:View>
