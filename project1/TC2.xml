<mvc:View controllerName="code.cl3.project1.controller.TC2"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
	xmlns:t="sap.ui.table"
	xmlns:u="sap.ui.unified">
    <!-- <Page id="page4" title="{i18n>title}"> -->
        <!-- <Button text="Click" press="onPress()" /> -->
        <MenuButton
		text="Select EntitySet"
		icon="sap-icon://menu2"
		useDefaultActionOnly="false"
		menu="{
			path: '',
			templateShareable: false
		}">
		<menu>
			<Menu>
				<items>
					<MenuItem text="AirlineSet" icon="sap-icon://flight" press=".onAirlineSet"/>
					<MenuItem text="PaymentSet" icon="sap-icon://credit-card" press=".onPaymentSet"/>
				</items>
			</Menu>
		</menu>
	</MenuButton>
	<Button icon="sap-icon://paper-plane" text="Select Service" press="onBack()" />
	<Panel class="sapUiResponsiveMargin" width="auto" >
			<t:Table
                id="table2"
				rows="{Model2>/FlightSet}"
				selectionMode="None"
				paste="onPaste"
				ariaLabelledBy="title">
				<t:extension>
					<OverflowToolbar style="Clear">
						<Title id="title2" text="Airline Scedules"/>
                        <ToolbarSpacer/>
                        <Button id="btn1" text="Search" icon="sap-icon://search" press="onInput()" />
                        <Input id="Air1" placeholder="Airline Code" width="10rem"  />
                        <Input id="Fr1" placeholder="Freight Code" width="10rem"  />
						<ToolbarSeparator/>
						<OverflowToolbarMenuButton>
							<menu>
								<Menu itemSelected="onMenuAction">
									<MenuItem text="Export to Excel" icon="sap-icon://excel-attachment" />
								</Menu>
							</menu>
						</OverflowToolbarMenuButton>						
					</OverflowToolbar>
				</t:extension>
				<t:columns>
					<t:Column width="auto">
						<Label text="Airline Code" />
						<t:template>
							<Text text="{Model2>Carrid}" wrapping="false" />
						</t:template>
					</t:Column>
					<t:Column width="auto">
						<Label text="Freight code" />
						<t:template>
							<Text text="{Model2>Connid}" wrapping="false" />
						</t:template>
					</t:Column>
					<t:Column width="auto">
						<Label text="Freight Date" />
						<t:template>
							<Text text="{Model2>Fldate}" wrapping="false" />
						</t:template>
					</t:Column>
					<t:Column width="11rem">
						<Label text="Price" />
						<t:template>
							<Text text="{Model2>Price}" wrapping="false" />
						</t:template>
					</t:Column>
					<t:Column width="11rem">
						<Label text="Currency" />
						<t:template>
							<Text text="{Model2>Currency}" wrapping="false" />
						</t:template>
					</t:Column>
					<t:Column width="11rem">
						<Label text="Aircraft Type" />
						<t:template>
							<Text text="{Model2>Planetype}" wrapping="false" />
						</t:template>
					</t:Column>                                                                                                                           
				</t:columns>  
            </t:Table>
        </Panel>                  			

    <!-- </Page> -->
</mvc:View>