<mvc:View controllerName="code.cl3.project1.controller.FlightView"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">
    <!-- <Page id="page" title="Login"> -->
        <!-- <Text text="1" />
        <Button text="Click" press="onSelect()" /> -->
        <FlexBox  direction="Column" justifyContent="Center" alignItems="Center" class="sapUiSmallMargin">
            <Panel headerText="SAP Airline Login" class="sapUiResponsiveMargin" width="30rem" height="20rem">
                <FlexBox width="100%" height="90%" class="sapUiSizeFull" direction="Column" justifyContent="Center" alignItems="Center">
                    <HBox alignContent="Center">
                        <Image src="data:image/png;base64," alt="Company Logo" width="200px" height="auto" />

                        <VBox alignItems="Center">
                            <HBox alignItems="Inherit">
                                <Label text="ID" class="sapUiTinyMarginEnd" width="5rem"></Label>
                                <Input placeholder="Input ID" id="idInput"></Input>
                            </HBox>
                            <HBox alignItems="Inherit">
                                <Label text="Password" class="sapUiTinyMarginEnd" width="5rem"></Label>
                                <Input placeholder="Input PW" type="Password" id="pwInput"></Input>
                            </HBox>
                            <HBox width="100%" justifyContent="End">
                                <Button icon="sap-icon://visits" type="Neutral" text="Login" press="onLogin"></Button>
                            </HBox>
                        </VBox>

                    </HBox>
                </FlexBox>
            </Panel>
        </FlexBox>
    <!-- </Page> -->
</mvc:View>