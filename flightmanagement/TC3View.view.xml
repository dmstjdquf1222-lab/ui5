<mvc:View controllerName="code.cl3.flightmanagement.controller.TC3View"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
	xmlns:t="sap.ui.table"
	xmlns:u="sap.ui.unified"
	xmlns:viz="sap.viz.ui5.controls" 
    xmlns:layout="sap.ui.layout"
    xmlns:viz.feeds="sap.viz.ui5.controls.common.feeds"
    xmlns:viz.data="sap.viz.ui5.data">
    <!-- <Page id="page5" title="{i18n>title}"> -->
        <!-- <Button text="Back" press="onBack()" /> -->
        <MenuButton
		text="Select EntitySet"
		icon="sap-icon://menu2"
		useDefaultActionOnly="false"
		menu="{
			path: '',
			templateShareable: false
		}">
		<menu>
			<Menu>
				<items>
					<MenuItem text="AirlineSet" icon="sap-icon://flight" press=".onAirlineSet"/>
					<MenuItem text="FlightSet" icon="sap-icon://suitcase" press=".onFlightSet"/>
				</items>
			</Menu>
		</menu>
	</MenuButton>
	<Button icon="sap-icon://paper-plane" text="Select Service" press="onBack()" />
	<Panel class="sapUiResponsiveMargin" width="75rem" height="30rem">
			<HBox width="100%" justifyContent="Start">
				<t:Table
					rowSelectionChange="onPayTableSelectionChange"
					id="payTable"
					rows="{Model2>/PaymentSet}"
					selectionMode="MultiToggle"
					visibleRowCount="8"
					width="23rem">
					<t:extension>
						<OverflowToolbar style="Clear">
							<Title id="title3" text="Airline Payment"/>
							<ToolbarSpacer/>
							<ToolbarSeparator/>
							<Button id="btn2" text="Search" icon="sap-icon://search" press="onInput2()" />
							<Input id="Air2" placeholder="Code" width="5rem"  />
						</OverflowToolbar>
					</t:extension>

					<t:columns>

						<t:Column width="4rem">
							<Label text="항공사" />
							<t:template>
								<Text text="{Model2>Carrid}" wrapping="false" />
							</t:template>
						</t:Column>
						<t:Column width="6rem">
							<Label text="항공 요금" />
							<t:template>
								<Text text="{Model2>Price}" wrapping="false" />
							</t:template>
						</t:Column>
						<t:Column width="9rem">
							<Label text="SUM" />
							<t:template>
								<Text text="{Model2>Paymentsum}" wrapping="false" />
							</t:template>
						</t:Column>    

					</t:columns>  

				</t:Table>

				<viz:VizFrame uiConfig="{applicationSet:'fiori'}" width="26rem" height='20rem' vizType='donut' id="idVizFrame2"
                vizProperties='{"title": { "text": "Payment sum", "visible": true }}'>

                <viz:dataset>
                    <viz.data:FlattenedDataset data="{chart>/rows}" >

                        <viz.data:dimensions>
                            <viz.data:DimensionDefinition name="Airline" value="{chart>Carrid}" />
                        </viz.data:dimensions>

                        <viz.data:measures>
                            <viz.data:MeasureDefinition name="Paymentsum" value="{chart>Paymentsum}" />
                        </viz.data:measures>

                    </viz.data:FlattenedDataset>
                </viz:dataset>

                <viz:feeds>
                    <viz.feeds:FeedItem uid="color" type="Dimension" values="Airline" />
                    <viz.feeds:FeedItem uid="size" type="Measure" values="Paymentsum" />
                </viz:feeds>

                <viz:dependents>
                    <viz:Popover id="idPopOver2"></viz:Popover>
                </viz:dependents>

            </viz:VizFrame>

            <viz:VizFrame uiConfig="{applicationSet:'fiori'}" width="25rem" height='20rem' vizType='scatter' id="idVizFrame"
                vizProperties='{"title": { "text": "Payment sum", "visible": true }}'>

                <viz:dataset>
                    <viz.data:FlattenedDataset data="{chart>/rows}" >

                        <viz.data:dimensions>
                            <viz.data:DimensionDefinition name="Airline" value="{chart>Carrid}"/> 
                        </viz.data:dimensions>

                        <viz.data:measures>
                            <viz.data:MeasureDefinition name="Paymentsum" value="{chart>Paymentsum}" />
                            <viz.data:MeasureDefinition name="Price" value="{chart>Price}" />

                        </viz.data:measures>

                    </viz.data:FlattenedDataset>
                </viz:dataset>

                <viz:feeds>
                    <viz.feeds:FeedItem uid="valueAxis" type="Measure" values="Paymentsum" />
                    <viz.feeds:FeedItem uid="valueAxis2" type="Measure" values="Price" />
                </viz:feeds>

                <viz:dependents>
                    <viz:Popover id="idPopOver"></viz:Popover>
                </viz:dependents>

            </viz:VizFrame>


			</HBox>
        </Panel>            

    <!-- </Page> -->
</mvc:View>