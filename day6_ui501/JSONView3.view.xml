        <Panel
            headerText="{file>/panelSet/header}"
            width="{file>/panelSet/width}"
            height="{file>/panelSet/height}"
        >
            <VBox>
                <HBox>
                    <Label
                        text="{file>/labelSet/text}"
                        width="{file>/labelSet/width}"
                        vAlign="{file>/labelSet/vAlign}"
                    />
                    <Input
                        value="{file>/inputSet/value}"
                        placeholder="{file>/inputSet/holder}"
                        width="{file>/inputSet/width}"
                        description="{file>/inputSet/desc}"
                    />
                    <Button
                        text="{file>/buttonSet/text}"
                        type="{file>/buttonSet/type}"
                        icon="{file>/buttonSet/icon}"
                    />
                </HBox>
                <Button
                    text="Array"
                    press="onArray()"
                />
            </VBox>
        </Panel>
        <Panel
            class="sapUiResponsiveMargin"
            width="auto"
        >
            <VBox>
                <t:Table
                    rows="{air>/airlineSet}"
                    selectionMode="None"
                    paste="onPaste"
                    ariaLabelledBy="title"
                >
                    <t:extension>
                        <OverflowToolbar style="Clear">
                            <Title
                                id="title"
                                text="Airline master"
                            />
                        </OverflowToolbar>
                    </t:extension>

                    <t:columns>
                        <t:Column
                            width="11rem"
                            hAlign="Center"
                        >
                            <Label text="Airline Code" />
                            <t:template>
                                <Text
                                    text="{air>Aircd}"
                                    wrapping="false"
                                />
                            </t:template>
                        </t:Column>

                        <t:Column
                            width="11rem"
                            hAlign="Center"
                        >
                            <Label text="Airline name" />
                            <t:template>
                                <Text text="{air>Airline}" />
                            </t:template>
                        </t:Column>

                        <t:Column
                            width="11rem"
                            hAlign="Center"
                        >
                            <Label text="URL" />
                            <t:template>
                                <Link

                                    text="{air>URL}"
                                    href="{air>/airlinSet/URL}"
                                />
                            </t:template>
                        </t:Column>

                        <t:Column
                            width="11rem"
                            hAlign="Center"
                        >
                            <Label text="Currency" />
                            <t:template>
                                <Text
                                    text="{air>Curr}"
                                    wrapping="false"
                                />
                            </t:template>
                        </t:Column>
                    </t:columns>
                </t:Table>
            </VBox>
        </Panel>
    </Page>
</mvc:View>
