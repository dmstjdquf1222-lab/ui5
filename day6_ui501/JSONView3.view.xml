<mvc:View
    xmlns:table="sap.ui.table"
    controllerName="code.cl3.day6ui501.controller.JSONView3"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:u="sap.ui.unified"
    xmlns:c="sap.ui.core"
    xmlns:t="sap.ui.table"
>
    <Page
        id="page"
        title="{i18n>title}"
    >
