<mvc:View
    controllerName="code.cl3.day7ui501.controller.TableView2"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:u="sap.ui.unified"
    xmlns:c="sap.ui.core"
    xmlns:t="sap.ui.table"
>
    <Page
        id="page"
        title="{i18n>title}"
    >
        <VBox>
            <t:Table
                rows="{/gsberSet}"
                selectionMode="Single"
                visibleRowCount = "6"
            >
                <t:extension>
                    <OverflowToolbar style="Clear">
                        <Title
                            id="title"
                            text="Gsber master"
                        />
                        
                    </OverflowToolbar>
                </t:extension>
                <t:columns>
                    <t:Column width="11rem">
                        <Label text="Business area" />
                        <t:template>
                            <Text
                                text="{Gsber}"
                                wrapping="false"
                            />
                        </t:template>
                    </t:Column>
                    <t:Column width="11rem">
                        <Label text="Biz area name" />
                        <t:template>
                            <Text
                                text="{Gtext}"
                                wrapping="false"
                            />
                        </t:template>
                    </t:Column>
                    <t:Column width="11rem">
                        <Label text="Product order" />
                        <t:template>
                            <Text
                                text="{Aufnr}"
                                wrapping="false"
                            />
                        </t:template>
                    </t:Column>
                    <t:Column width="11rem">
                        <Label text="Customer id" />
                        <t:template>
                            <Text
                                text="{Kunnr}"
                                wrapping="false"
                            />
                        </t:template>
                    </t:Column>
                </t:columns>
            </t:Table>
        </VBox>
    </Page>
</mvc:View>
