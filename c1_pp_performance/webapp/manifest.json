        "path": "c1.pp.c1ppperformance.view",
        "async": true,
        "viewPath": "c1.pp.c1ppperformance.view"
      },
      "routes": [
        {
          "name": "Routec1_pp_performance",
          "pattern": ":?query:",
          "target": [
            "Targetc1_pp_performance"
          ]
        }
      ],
      "targets": {
        "Targetc1_pp_performance": {
          "id": "c1_pp_performance",
          "name": "c1_pp_performance"
        }
      }
    },
    "rootView": {
      "viewName": "c1.pp.c1ppperformance.view.App",
      "type": "XML",
      "id": "App",
      "async": true
    }
  }
