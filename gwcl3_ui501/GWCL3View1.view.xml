                </content>
            </Popover>
        </dependents>
        <Panel
            class="sapUiResponsiveMargin"
            headerText="Flight schedul"
            width="50rem"
            expandable="true"
            expanded="true"
        >
            <t:Table
                id="Schedule"
                rows="{flight>/FlightSet}"
                selectionMode="None"
                visibleRowCount="12"
            >
                <t:extension>
                    <OverflowToolbar style="Clear">
                        <Title
                            id="title2"
                            text="Schedule master"
                        />
                        <ToolbarSpacer />
                        <Button
                            text="Search"
                            icon="sap-icon://search"
                            press="onSearch"
                        />
                        <Input
                            id="ipt2"
                            placeholder="Carrid"
                            width="10rem"
                            showClearIcon="true"
                        />
                    </OverflowToolbar>
                </t:extension>
                <t:columns>
                    <t:Column width="auto">
                        <Label text="Airline" />
                        <t:template>
                            <Label text="{flight>Carrid}" />
                        </t:template>
                    </t:Column>
                    <t:Column width="auto">
                        <Label text="Flight Connerction" />
                        <t:template>
                            <Label text="{flight>Connid}" />
                        </t:template>
                    </t:Column>
                    <t:Column width="auto">
                        <Label text="Flight date" />
                        <t:template>
                            <Label text="{flight>Fldate}" />
                        </t:template>
                    </t:Column>
                    <t:Column width="auto">
                        <Label text="Airfare" />
                        <t:template>
                            <Label text="{flight>Price}" />
                        </t:template>
                    </t:Column>
                    <t:Column width="auto">
                        <Label text="Currency" />
                        <t:template>
                            <Label text="{flight>Currency}" />
                        </t:template>
                    </t:Column>
                    <t:Column width="auto">
                        <Label text="Aircraft Type" />
                        <t:template>
                            <Label text="{flight>Planetype}" />
                        </t:template>
                    </t:Column>
                </t:columns>
            </t:Table>
        </Panel>
        <Panel>
            <viz:VizFrame
                id="idVizFrame"
                uiConfig="{applicationSet:'fiori'}"
                height='30rem'
                width="40rem"
                vizType='scatter'
            >
                <viz:dataset>
                    <viz.data:FlattenedDataset data="{flight>/PaymentSet}">
                        <viz.data:dimensions>
                            <viz.data:DimensionDefinition
                                name="Carrid"
                                value="{Carrid}"
                            />
                        </viz.data:dimensions>
                        <viz.data:measures>
                            <viz.data:MeasureDefinition
                                name="Price"
                                value="{Price}"
                            />
                            <viz.data:MeasureDefinition
                                name="Paymentsum"
                                value="{Paymentsum}"
                            />
                        </viz.data:measures>
                    </viz.data:FlattenedDataset>
                </viz:dataset>

                <viz:feeds>
                    <viz.feeds:FeedItem
                        uid="color"
                        type="Dimension"
                        values="Carrid"
                    />
                    <viz.feeds:FeedItem
                        uid="valueAxis"
                        type="Measure"
                        values="Price"
                    />
                    <viz.feeds:FeedItem
                        uid="valueAxis2"
                        type="Measure"
                        values="Paymentsum"
                    />
                </viz:feeds>
                <viz:dependents>
                    <viz:Popover id="idPopOver" />
                </viz:dependents>
            </viz:VizFrame>
        </Panel>
        <Panel>
            <viz:VizFrame
                id="idVizFram2e"
                uiConfig="{applicationSet:'fiori'}"
                height='30rem'
                width="30rem"
                vizType='timeseries_scatter'
            >
                <viz:dataset>
                    <viz.data:FlattenedDataset data="{flight>/FlightSet}">
                        <viz.data:dimensions>
                            <viz.data:DimensionDefinition
                                name="Date"
                                value="{Fldate}"
                                dataType="date"
                            />
                        </viz.data:dimensions>
                        <viz.data:measures>
                            <viz.data:MeasureDefinition
                                name="Carrid"
                                value="{Carrid}"
                            />
                        </viz.data:measures>
                    </viz.data:FlattenedDataset>
                </viz:dataset>

                <viz:feeds>
                    <viz.feeds:FeedItem
                        uid="valueAxis"
                        type="Measure"
                        values="Carrid"
                    />
                    <viz.feeds:FeedItem
                        uid="timeAxis"
                        type="Dimension"
                        values="Date"
                    />
                </viz:feeds>
                <viz:dependents>
                    <viz:Popover id="idPopOver22" />
                </viz:dependents>
            </viz:VizFrame>
        </Panel>
    </Page>
</mvc:View>
