<mvc:View
    controllerName="code.cl3.gwcl3ui501.controller.GWCL3View1"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:t="sap.ui.table"
    xmlns:u="sap.ui.unified"
    xmlns:c="sap.ui.core"
    xmlns:viz="sap.viz.ui5.controls"
    xmlns:layout="sap.ui.layout"
    xmlns:viz.feeds="sap.viz.ui5.controls.common.feeds"
    xmlns:viz.data="sap.viz.ui5.data"
    xmlns:m="sap.suite.ui.microchart"
>
    <Page
        id="page"
        title="{i18n>title}"
    >
        <Panel
            class="sapUiResponsiveMargin"
            headerText="Gateway service"
            width="40rem"
            expandable="true"
            expanded="true"
        >
            <t:Table
                id="airline"
                rows="{/AirlineSet}"
                selectionMode="None"
                visibleRowCount="12"
            >
                <t:extension>
                    <OverflowToolbar style="Clear">
                        <Title
                            id="title"
                            text="Airline master"
                        />
                        <ToolbarSpacer />
                        <Button
                            text="Search"
                            icon="sap-icon://search"
                            press="onPress"
                        />
                        <Input
                            id="ipt1"
                            placeholder="Airline name"
                            width="10rem"
                            showClearIcon="true"
                        />
                    </OverflowToolbar>
                </t:extension>
                <t:columns>
                    <t:Column width="5rem">
                        <Label text="Airline" />
                        <t:template>
                            <Label text="{Carrid}" />
                        </t:template>
                    </t:Column>
                    <t:Column width="10rem">
                        <Label text="Airline name" />
                        <t:template>
                            <Label text="{Carrname}" />
                        </t:template>
                    </t:Column>
                    <t:Column width="5rem">
                        <Label text="Currency" />
                        <t:template>
                            <Label text="{Currcode}" />
                        </t:template>
                    </t:Column>
                    <t:Column width="15rem">
                        <Label text="Home page" />
                        <t:template>
                            <Link
                                text="{Url}"
                                href="{Url}"
                                target="_blank"
                            />
                        </t:template>
                    </t:Column>
                </t:columns>
            </t:Table>
        </Panel>

        <Panel
            width="auto"
            height="15rem"
        >
            <content>
                <Button
                    text="show chart"
                    press="onPress1"
                />
            </content>
        </Panel>
        <dependents>
            <Popover
                id="vizPopover"
                title="차트"
                contentWidth="20rem"
                contentHeight="10rem"
                placement="Auto"
            >
                <content>
                    <Table items="{flight>/PaymentSet}">
                        <columns>
                            <Column>
                                <Text text="항공사" />
                            </Column>
                            <Column>
                                <Text text="가격" />
                            </Column>
                        </columns>
                        <items>
                            <ColumnListItem>
                                <ObjectIdentifier title="{flight>Carrid}" />
                                <ObjectNumber number="{flight>Price}" />
                            </ColumnListItem>
                        </items>
                    </Table>

