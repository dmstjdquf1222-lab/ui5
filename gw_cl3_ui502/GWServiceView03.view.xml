<mvc:View
    controllerName="code.cl3.gwcl3ui502.controller.GWServiceView03"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:viz="sap.viz.ui5.controls"
    xmlns:layout="sap.ui.layout"
    xmlns:viz.feeds="sap.viz.ui5.controls.common.feeds"
    xmlns:viz.data="sap.viz.ui5.data"
    xmlns:m="sap.suite.ui.microchart"
>
    <Page
        id="page"
        title="{i18n>title}"
    >
        <VBox>
            <Panel
                class="sapUiResponsiveMargin"
                headerText="Line chart"
                width="auto"
                expandable="true"
            >
                <viz:VizFrame
                    id="idVizFrame"
                    uiConfig="{applicationSet:'fiori'}"
                    height='30rem'
                    width="100%"
                    vizType='line'
                    vizProperties="{ title: {text : 'Payment', visible : true}}"
                >
                    <viz:dataset>
                        <viz.data:FlattenedDataset data="{/PaymentSet}">
                            <viz.data:dimensions>
                                <viz.data:DimensionDefinition
                                    name="Carrid"
                                    value="{Carrid}"
                                />
                            </viz.data:dimensions>
                            <viz.data:measures>
                                <viz.data:MeasureDefinition
                                    name="Price"
                                    value="{Price}"
                                />
                            </viz.data:measures>
                        </viz.data:FlattenedDataset>
                    </viz:dataset>

                    <viz:feeds>
                        <viz.feeds:FeedItem
                            id='valueAxisFeed'
                            uid="valueAxis"
                            type="Measure"
                            values="Price"
                        />
                        <viz.feeds:FeedItem
                            id='categoryAxisFeed'
                            uid="categoryAxis"
                            type="Dimension"
                            values="Carrid"
                        />
                    </viz:feeds>
                    <viz:dependents>
                        <viz:Popover id="idPopOver" />
                    </viz:dependents>
                </viz:VizFrame>
            </Panel>
            <Panel
                class="sapUiResponsiveMargin"
                headerText="Radar chart"
                width="auto"
                expandable="true"
            >
                <viz:VizFrame
                    id="idVizFrame2"
                    uiConfig="{applicationSet:'fiori'}"
                    height='30rem'
                    width="100%"
                    vizType='radar'
                    vizProperties="{ title: {text : 'Payment', visible : true}}"
                >
                    <viz:dataset>
                        <viz.data:FlattenedDataset data="{/PaymentSet}">
                            <viz.data:dimensions>
                                <viz.data:DimensionDefinition
                                    name="Carrid"
                                    value="{Carrid}"
                                />
                            </viz.data:dimensions>
                            <viz.data:measures>
                                <viz.data:MeasureDefinition
                                    name="Price"
                                    value="{Price}"
                                />
                            </viz.data:measures>
                        </viz.data:FlattenedDataset>
                    </viz:dataset>

                    <viz:feeds>
                        <viz.feeds:FeedItem
                            id='valueAxisFeed2'
                            uid="valueAxis"
                            type="Measure"
                            values="Price"
                        />
                        <viz.feeds:FeedItem
                            id='categoryAxisFeed2'
                            uid="categoryAxis"
                            type="Dimension"
                            values="Carrid"
                        />
                    </viz:feeds>
                    <viz:dependents>
                        <viz:Popover id="idPopOver2" />
                    </viz:dependents>
                </viz:VizFrame>
            </Panel>
            <Panel
                class="sapUiResponsiveMargin"
                headerText="Micro chart(Donut)"
                width="auto"
                expandable="true"
            >
                <FlexBox
                    width="auto"
                    height="auto"
                    alignItems="Center"
                    class="sapUiSmallMargin"
                >
                    <items>
                        <m:InteractiveDonutChart
                            segments="{/PaymentSet}"
                            displayedSegments="8"
                        >
                            <m:segments>
                                <m:InteractiveDonutChartSegment
                                    label="{Carrid}"
                                    value="{=parseFloat(${Price})}"
                                    displayedValue="{Price}"
                                />
                            </m:segments>
                        </m:InteractiveDonutChart>
                    </items>
                </FlexBox>
            </Panel>
            <Panel
                class="sapUiResponsiveMargin"
                headerText="Micro chart(Line)"
                width="auto"
                expandable="true"
            >
                <FlexBox
                    width="auto"
                    height="30rem"
                    alignItems="Center"
                    class="sapUiSmallMargin"
                >
                    <items>
                        <m:InteractiveLineChart
                            selectionChanged="selectionChanged"
                            press="press"
                            points="{/PaymentSet}"
                            displayedPoints="8"
                        >
                            <m:points>
                                <m:InteractiveLineChartPoint
                                    value="{=parseFloat(${Price})}"
                                    label="{Carrid}"
                                />
                            </m:points>
                        </m:InteractiveLineChart>
                    </items>
                </FlexBox>
            </Panel>
        </VBox>
    </Page>
</mvc:View>
